# API Configuration
VITE_API_URL=https://api.biblestem.com
VITE_API_VERSION=v1

# Supabase Configuration (Backend)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Sanity Configuration (Content Management)
VITE_SANITY_PROJECT_ID=your-sanity-project-id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# Environment
VITE_ENVIRONMENT=development
VITE_IS_MOCK_MODE=true

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_PWA=true

# External Services
VITE_ALGOLIA_APP_ID=your-algolia-app-id
VITE_ALGOLIA_API_KEY=your-algolia-api-key
VITE_ALGOLIA_INDEX_NAME=biblestem_studies

# Stripe (Payments)
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Email Service
VITE_EMAIL_SERVICE_URL=your-email-service-url

# Sentry (Error Tracking)
VITE_SENTRY_DSN=your-sentry-dsn
VITE_SENTRY_ENVIRONMENT=development

