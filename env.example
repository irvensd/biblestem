# Copy to `.env.local` in the project root (never commit real keys — env.example is a template only).

# -----------------------------------------------------------------------------
# Public (bundled into the browser with NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
# Supabase — Project Settings → API — use the anon / public key only here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# When both URL and anon key are set, the app uses Supabase Auth + cloud progress (RLS).
# Without both, sign-in and account creation are disabled until configuration is added (then redeploy).
# For local sign-up testing, turn off “Confirm email” under Authentication → Providers → Email.

# Public site origin for canonical URLs, sitemap, and password-reset emails.
# Production: https://biblestem.io
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Server-only (never use in client components or NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
# Service role bypasses RLS — scripts and CI only (e.g. npm run sync:supabase:reader).
# Do not paste this into the app or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
