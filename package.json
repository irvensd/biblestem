    "deploy:vercel": "./scripts/deploy.sh production vercel",
    "docker:build": "./scripts/build-docker.sh",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down"
  },
  "dependencies": {
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.76.1",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.14.7",
    "@types/node": "^22.15.32",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.4.7",
    "eslint": "^9.29.0",
    "eslint-config-next": "^16.2.1",
    "postcss": "^8.5.6",
    "prettier": "3.5.3",
    "tailwindcss": "^3.4.11",
    "tsx": "^4.19.3",
    "typescript": "5.8.3"
  }
