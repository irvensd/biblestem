{
  "name": "biblestem",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "preview": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "check:lesson-copy": "tsx scripts/check-lesson-copy-style.ts",
    "check:app-readiness": "npm run type-check && npm run lint && npm run check:lesson-copy",
    "format": "prettier --write .",
    "sync:supabase:reader": "tsx scripts/sync-reader-content-to-supabase.ts",
    "seed:supabase:faithful-in-the-wilderness": "tsx scripts/seed-faithful-in-the-wilderness-catalog.ts",
    "seed:supabase:the-millennium": "tsx scripts/seed-the-millennium-catalog.ts",
    "seed:supabase:the-end-of-evil": "tsx scripts/seed-the-end-of-evil-catalog.ts",
    "seed:supabase:the-world-love-restores": "tsx scripts/seed-the-world-love-restores-catalog.ts",
    "seed:supabase:when-heaven-broke": "tsx scripts/seed-when-heaven-broke-origin-of-evil-catalog.ts",
    "seed:supabase:why-does-god-allow-suffering": "tsx scripts/seed-why-does-god-allow-suffering-catalog.ts",
    "seed:supabase:the-faithful-witness": "tsx scripts/seed-the-faithful-witness-catalog.ts",
    "seed:supabase:the-day-of-atonement": "tsx scripts/seed-the-day-of-atonement-catalog.ts",
    "seed:supabase:the-first-angels-message": "tsx scripts/seed-the-first-angels-message-catalog.ts",
    "seed:supabase:the-second-angels-message": "tsx scripts/seed-the-second-angels-message-catalog.ts",
    "seed:supabase:the-third-angels-message": "tsx scripts/seed-the-third-angels-message-catalog.ts",
