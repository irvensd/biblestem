{
  "name": "biblestem",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "preview": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "check:lesson-copy": "tsx scripts/check-lesson-copy-style.ts",
    "check:app-readiness": "npm run type-check && npm run lint && npm run check:lesson-copy",
    "format": "prettier --write .",
    "sync:supabase:reader": "tsx scripts/sync-reader-content-to-supabase.ts",
    "deploy:netlify": "./scripts/deploy.sh production netlify",
    "deploy:vercel": "./scripts/deploy.sh production vercel",
    "docker:build": "./scripts/build-docker.sh",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.76.1",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.14.7",
    "@types/node": "^22.15.32",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.29.0",
    "eslint-config-next": "^16.2.1",
    "postcss": "^8.5.6",
    "prettier": "3.5.3",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.3",
    "tailwindcss": "^3.4.11",
    "typescript": "~5.8.0"
  }
}
